# The release targets the app is built for, one platform() each, so
# `bazel build --config=<name> //:meiro` cross-compiles without any GOOS or
# GOARCH juggling. rules_go picks the matching Go toolchain from these
# constraints.
#
# darwin_amd64 and darwin_arm64 say osx rather than macos: @platforms//os:macos
# is an alias for the same constraint, and the alias is deprecated.

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "windows_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)
