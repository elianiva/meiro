+func killProcessGroupOnCancel(*exec.Cmd) {}
diff -ruN a/lyrics/command_unix.go b/lyrics/command_unix.go
--- a/lyrics/command_unix.go
+++ b/lyrics/command_unix.go
@@ -0,0 +1,15 @@
+//go:build unix
+
+package lyrics
+
+import (
+	"os/exec"
+	"syscall"
+)
+
+// killProcessGroupOnCancel runs cmd in its own process group and kills the
+// whole group on cancel, so a script's children do not outlive the timeout.
+func killProcessGroupOnCancel(cmd *exec.Cmd) {
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	cmd.Cancel = func() error { return syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL) }
+}
