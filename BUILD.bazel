load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Every Go file in the repository, which is what the formatting check reads.
# Sources are listed rather than walked so the test only ever sees files Bazel
# knows about.
GO_SOURCES = glob(
    ["**/*.go"],
    exclude = ["bazel-*/**"],
)

# Gazelle writes and updates every BUILD file under the workspace, so the Go
# targets stay in step with go.mod and the packages on disk.
gazelle_binary(
    name = "gazelle_binary",
    languages = ["@gazelle//language/go"],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_binary",
)

# bazel run //:gazelle_update_repos follows go.mod into MODULE.bazel.
gazelle(
    name = "gazelle_update_repos",
    command = "update-repos",
    gazelle = ":gazelle_binary",
)

# --- The commands a contributor runs -----------------------------------------
#
# One Bazel command stands in for each recipe the justfile used to hold. The
# targets that only arrange work (dev, fetch-tools, format, lint, tidy, dist,
# clean) run outside the sandbox, because they need the network, the host
# toolchain, or the platform's own packaging tools; the targets that check
# something (test, format_test) are hermetic and cached.

# Live reload: `bazel run //:dev`.
sh_binary(
    name = "dev",
    srcs = ["//tools:workspace.sh"],
    args = [
        "go",
        "tool",
        "mygo",
        "dev",
    ],
    visibility = ["//visibility:public"],
)

# The playback tools a full build ships: `bazel run //:fetch-tools -- linux-amd64`.
# (The name cannot be `tools`: a target of that name in the root package would
# collide with the tools/ package's output directory.)
sh_binary(
    name = "fetch-tools",
    srcs = ["//tools:workspace.sh"],
    args = ["scripts/fetch-tools.sh"],
    visibility = ["//visibility:public"],
)

# Format in place: `bazel run //:format`.
sh_binary(
    name = "format",
    srcs = ["//tools:format.sh"],
    args = ["$(rootpath @cc_mvdan_gofumpt//:gofumpt)"],
    data = ["@cc_mvdan_gofumpt//:gofumpt"],
    visibility = ["//visibility:public"],
)

# Fail when a file is not formatted: `bazel test //:format_test`.
sh_test(
    name = "format_test",
    size = "small",
    srcs = ["//tools:format_test.sh"],
    args = ["$(rootpath @cc_mvdan_gofumpt//:gofumpt)"],
    data = GO_SOURCES + ["@cc_mvdan_gofumpt//:gofumpt"],
)

# Lint with the pinned golangci-lint: `bazel run //:lint`.
sh_binary(
    name = "lint",
    srcs = ["//tools:lint.sh"],
    args = ["$(rootpath @golangci_lint//:bin)"],
    data = ["@golangci_lint//:bin"],
    visibility = ["//visibility:public"],
)

# Check go.mod and go.sum: `bazel run //:tidy`. go.mod is still where the Go
# dependencies are written down, so it has to stay tidy for //:gazelle to
# follow it.
sh_binary(
    name = "tidy",
    srcs = ["//tools:workspace.sh"],
    args = [
        "go",
        "mod",
        "tidy",
        "-diff",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "dist",
    actual = "//tools:dist",
    visibility = ["//visibility:public"],
)

alias(
    name = "clean",
    actual = "//tools:clean",
    visibility = ["//visibility:public"],
)

