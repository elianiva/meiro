load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "player",
    srcs = [
        "equalizer.go",
        "null.go",
        "pipe_linux.go",
        "pipe_other.go",
        "pipe_windows.go",
        "player.go",
        "video.go",
        "window_unix.go",
        "window_windows.go",
    ],
    importpath = "github.com/elianiva/meiro/player",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_ebitengine_oto_v3//:oto",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "player_test",
    srcs = [
        "eq_test.go",
        "integration_test.go",
        "player_test.go",
        "video_test.go",
    ],
    embed = [":player"],
)
